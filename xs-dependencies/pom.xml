<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.xsframework</groupId>
  <artifactId>xs-dependencies</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>xs-dependencies</name>
  <description>Single source of truth for third-party versions</description>

  <properties>
    <spring-boot.version>4.2.0</spring-boot.version>
    <spring-cloud.version>2026.0.0</spring-cloud.version>
    <springdoc.version>3.2.1</springdoc.version>
    <postgresql.version>42.7.15</postgresql.version>
    <archunit.version>1.5.0</archunit.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>com.xsframework</groupId>
        <artifactId>xs-common-core</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.xsframework</groupId>
        <artifactId>xs-api-user</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.xsframework</groupId>
        <artifactId>xs-api-tenant</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.xsframework</groupId>
        <artifactId>xs-module-tenant</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.xsframework</groupId>
        <artifactId>xs-adapter-user-http</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.xsframework</groupId>
        <artifactId>xs-app-tenant</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.xsframework</groupId>
        <artifactId>xs-starter-web</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.xsframework</groupId>
        <artifactId>xs-starter-data</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.xsframework</groupId>
        <artifactId>xs-module-user</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.xsframework</groupId>
        <artifactId>xs-app-monolith</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.xsframework</groupId>
        <artifactId>xs-app-user</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.springframework.cloud</groupId>
        <artifactId>spring-cloud-dependencies</artifactId>
        <version>${spring-cloud.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.springdoc</groupId>
        <artifactId>springdoc-openapi-bom</artifactId>
        <version>${springdoc.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.postgresql</groupId>
        <artifactId>postgresql</artifactId>
        <version>${postgresql.version}</version>
      </dependency>
      <dependency>
        <groupId>com.tngtech.archunit</groupId>
        <artifactId>archunit-junit5</artifactId>
        <version>${archunit.version}</version>
        <scope>test</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>
</project>
