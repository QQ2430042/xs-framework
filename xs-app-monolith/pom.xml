<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.xsframework</groupId>
    <artifactId>xs-framework</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>
  <artifactId>xs-app-monolith</artifactId>
  <name>xs-app-monolith</name>
  <description>Monolith assembly: all modules in one deployable jar</description>

  <dependencies>
    <dependency>
      <groupId>com.xsframework</groupId>
      <artifactId>xs-module-user</artifactId>
    </dependency>
    <dependency>
      <groupId>com.xsframework</groupId>
      <artifactId>xs-module-tenant</artifactId>
    </dependency>
    <dependency>
      <groupId>com.xsframework</groupId>
      <artifactId>xs-adapter-user-http</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-flyway</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>runtime</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <classifier>boot</classifier>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
